# locationrelay configuration — copy to .env and fill in real values.
# NEVER commit a real .env. Generate a strong token, e.g.:
#   openssl rand -base64 36

# REQUIRED. Shared secret Overland sends as `Authorization: Bearer <token>`
# (or as ?access_token=<token>). Must be at least 16 characters.
LOCATIONRELAY_TOKEN=replace-with-a-long-random-secret

# Address to bind. Keep on localhost; TLS is terminated by the reverse proxy.
LOCATIONRELAY_BIND=127.0.0.1:8080

# Directory where NDJSON beacon files are written (one file per UTC day).
LOCATIONRELAY_DATA_DIR=./data

# Maximum accepted request body in bytes (default 1 MiB). Overland batches up to
# ~200 points; 1 MiB is generous. Lower it to tighten the DoS surface.
LOCATIONRELAY_MAX_BODY_BYTES=1048576

# Per-request timeout in seconds.
LOCATIONRELAY_REQUEST_TIMEOUT_SECS=15

# Max concurrent in-flight requests.
LOCATIONRELAY_MAX_CONCURRENCY=64

# Per-client rate limit: sustained requests/second and burst allowance.
LOCATIONRELAY_RATE_PER_SECOND=5
LOCATIONRELAY_RATE_BURST=10

# fsync each batch to disk before responding (durable but slower). true/false.
LOCATIONRELAY_FSYNC=true

# Optional tracing filter, e.g. "locationrelay=debug" to see per-rejection logs.
# LOCATIONRELAY_LOG=locationrelay=info,tower_http=warn
